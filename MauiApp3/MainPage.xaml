<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp3.MainPage">

    <Grid
        RowDefinitions ="*, *, *, *, *, *, *" 
        ColumnDefinitions = "*,*,*,*">

        <Label
            Grid.Row="0"
            Background="Red"
            TextColor="White"
            Text="Grid1"
            FontSize="20" />

        <Label
            Grid.Row="1"
            Background="green"
            TextColor="White"
            Text="Grid2"
            FontSize="20" />

        <Label
            Grid.Row="2"
            Background="blue"
            TextColor="White"
            Text="Grid3"
            FontSize="20" />

        <Button
            Grid.Row="3"
            Background="grey"
            TextColor="white"
            Text="7"
            CornerRadius="15"
            FontSize="20" />

        <Button
            Grid.Row="4"
            Text="4"
            Style="{StaticResource CalcButtonStyle}" /> "


    </Grid>
</ContentPage>
